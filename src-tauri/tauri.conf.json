{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumo",
  "version": "2.1.0",
  "identifier": "com.hao.lumo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumo Player",
        "visible": false,
        "width": 1200,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "additionalBrowserArgs": "--disable-smooth-scrolling"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
